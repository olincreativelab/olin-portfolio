# =============================================================================
# OLIN.OS PORTFOLIO — CONFIGURATION ENVIRONNEMENT
# =============================================================================
#
# Copier ce fichier en `.env` et remplir les valeurs.
# Ne JAMAIS committer le fichier `.env` (déjà dans .gitignore).
#
# @author Josselin Hillion - Senior Product Designer & Builder
# @date 2026-09-25

# -----------------------------------------------------------------------------
# FIGMA API ACCESS TOKEN
# -----------------------------------------------------------------------------
# Token d'accès personnel Figma (Settings > Personal Access Tokens)
# Permissions requises : File content (read-only)
#
# Documentation : https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=your_figma_token_here

# -----------------------------------------------------------------------------
# FIGMA FILE KEY
# -----------------------------------------------------------------------------
# Clé du fichier Design System (extraite de l'URL Figma)
# URL format : https://www.figma.com/design/{FILE_KEY}/...
#
# Valeur par défaut pour Olin.os :
FIGMA_FILE_KEY=fmKmdTcWSH2mE4WXWV37eW

# -----------------------------------------------------------------------------
# VERCEL DEPLOYMENT (OPTIONNEL)
# -----------------------------------------------------------------------------
# Token de déploiement Vercel pour CI/CD
# VERCEL_TOKEN=your_vercel_token_here
