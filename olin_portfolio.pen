                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "s1-tag-1044",
                      "content": "01 / DISCOVERY • FOCUS",
                      "fontSize": 10,
                      "fontWeight": "800",
                      "fill": "#A16207"
                    },
                    {
                      "type": "text",
                      "id": "s1-title-1045",
                      "content": "IMMERSION SANS FILTRE",
                      "fontSize": 17,
                      "fontWeight": "900",
                      "fill": "#713F12"
                    },
                    {
                      "type": "text",
                      "id": "s1-desc-1046",
                      "content": "Cartographie des irritants réels. Observer les gestes métiers là où ils se déroulent : sur les chantiers poussiéreux, en concession ou dans les cockpits.",
                      "fontSize": 13,
                      "fill": "#854D0E",
                      "lineHeight": 1.5
                    },
                    {
                      "type": "text",
                      "id": "s1-sign-1047",
                      "content": "✍️ Josselin (Product) • 15j chantiers",
                      "fontSize": 11,
                      "fontWeight": "700",
                      "fill": "#A16207"
                    },
                    {
                      "type": "frame",
                      "id": "s1-comm-1048",
                      "name": "Comment Thread",
                      "fill": "#FFFFFF",
                      "stroke": {
                        "align": "inside",
                        "thickness": 1,
                        "fill": "#E2E8F0"
                      },
                      "cornerRadius": 12,
                      "padding": [
                        10,
                        14
                      ],
                      "layout": "vertical",
                      "gap": 4,
                      "children": [
                        {
                          "type": "text",
                          "id": "s1-c-hdr-1049",
                          "content": "💬 Josselin Hillion • il y a 2h",
                          "fontSize": 10,
                          "fontWeight": "800",
                          "fill": "#8718DC"
                        },
                        {
                          "type": "text",
                          "id": "s1-c-body-1050",
                          "content": "« Sur le chantier BTP, les artisans avaient les doigts sales et portaient des gants : d’où les boutons géants 56px et le offline-first. »",
                          "fontSize": 11,
                          "fill": "#01050F",
                          "lineHeight": 1.4
                        },
                        {
                          "type": "text",
                          "id": "s1-c-reac-1051",
                          "content": "👍 12  💯 8",
                          "fontSize": 10,
                          "fontWeight": "700",
                          "fill": "#64748B"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "stk-2-1052",
