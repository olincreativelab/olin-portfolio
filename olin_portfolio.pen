                      "children": [
                        {
                          "type": "text",
                          "id": "s3-c-hdr-1067",
                          "content": "💬 Direction Design • approuvé",
                          "fontSize": 10,
                          "fontWeight": "800",
                          "fill": "#8718DC"
                        },
                        {
                          "type": "text",
                          "id": "s3-c-body-1068",
                          "content": "« Un Design System n’est pas un musée de boutons, c’est le langage commun qui permet de concevoir 3x plus vite sans régresser. »",
