                  "cornerRadius": 16,
                  "padding": [
                    20,
                    20
                  ],
                  "layout": "vertical",
                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "s2-tag-1053",
                      "content": "02 / CODE & PROD • SHIPPED",
                      "fontSize": 10,
                      "fontWeight": "800",
                      "fill": "#047857"
                    },
                    {
                      "type": "text",
                      "id": "s2-title-1054",
                      "content": "DU CONCEPT AU COMMIT",
                      "fontSize": 17,
                      "fontWeight": "900",
                      "fill": "#065F46"
                    },
                    {
                      "type": "text",
                      "id": "s2-desc-1055",
                      "content": "Zéro déperdition d’intention. Maîtrise des composants React, HTML/CSS au cordeau, APIs et Webhooks. Ce qui est maquetté est ce qui tourne en prod.",
                      "fontSize": 13,
                      "fill": "#065F46",
                      "lineHeight": 1.5
                    },
                    {
                      "type": "text",
                      "id": "s2-sign-1056",
                      "content": "⚡️ Josselin (Builder) • 100% Code Prod",
                      "fontSize": 11,
                      "fontWeight": "700",
                      "fill": "#047857"
                    },
                    {
                      "type": "frame",
                      "id": "s2-comm-1057",
                      "name": "Comment Thread",
                      "fill": "#FFFFFF",
                      "stroke": {
                        "align": "inside",
                        "thickness": 1,
                        "fill": "#E2E8F0"
                      },
                      "cornerRadius": 12,
                      "padding": [
                        10,
                        14
                      ],
                      "layout": "vertical",
                      "gap": 4,
                      "children": [
                        {
                          "type": "text",
                          "id": "s2-c-hdr-1058",
                          "content": "💬 Tech Lead Ekino • validé",
                          "fontSize": 10,
                          "fontWeight": "800",
                          "fill": "#059669"
                        },
                        {
                          "type": "text",
                          "id": "s2-c-body-1059",
                          "content": "« Travailler avec Josselin fait gagner un sprint complet par release : les tokens et composants sont déjà prêts pour l’intégration. »",
                          "fontSize": 11,
                          "fill": "#01050F",
                          "lineHeight": 1.4
                        },
                        {
                          "type": "text",
                          "id": "s2-c-reac-1060",
