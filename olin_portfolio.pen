                  "gap": 10,
                  "children": [
                    {
                      "type": "text",
                      "id": "s3-tag-1062",
                      "content": "03 / SCALABILITÉ • SYSTÈMES",
                      "fontSize": 10,
                      "fontWeight": "800",
                      "fill": "#6B21A8"
                    },
                    {
                      "type": "text",
                      "id": "s3-title-1063",
                      "content": "SYSTÈMES VIVANTS",
                      "fontSize": 17,
                      "fontWeight": "900",
                      "fill": "#581C87"
                    },
                    {
                      "type": "text",
                      "id": "s3-desc-1064",
                      "content": "Standardisation rigoureuse des bibliothèques de composants, documentation interactive et tokens partagés entre design et dev (W3C, WCAG AAA).",
